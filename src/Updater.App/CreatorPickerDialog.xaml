<ui:FluentWindow x:Class="Updater.App.CreatorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="작가 매핑" Width="460" Height="560" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="작가 매핑" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,0">
            <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" FontSize="13"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Text="팔로우/후원 중인 작가 목록입니다. 더블클릭하면 바로 매핑됩니다."/>
        </StackPanel>

        <ui:TextBox x:Name="TxtSearch" Grid.Row="2" Margin="20,6,20,8" PlaceholderText="작가명 또는 creatorId 검색"
                    ClearButtonEnabled="True" TextChanged="TxtSearch_TextChanged"/>

        <Border Grid.Row="3" Margin="20,0" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Border Background="#2AFFFFFF" CornerRadius="4" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SiteLabel}" FontSize="10.5" Foreground="#C0C0C0"/>
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CreatorId}" Foreground="#9A9A9A" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="4" Margin="20,12,20,16">
            <TextBlock x:Name="TxtCount" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnUnmap" Content="매핑 해제" Click="BtnUnmap_Click" Padding="14,6"/>
                <ui:Button Content="취소" IsCancel="True" Margin="8,0,0,0" Padding="18,6"/>
                <ui:Button x:Name="BtnOk" Content="매핑" Appearance="Primary" IsDefault="True" Click="BtnOk_Click"
                           Margin="8,0,0,0" Padding="18,6"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
