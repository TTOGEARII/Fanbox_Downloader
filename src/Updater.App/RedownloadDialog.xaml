<ui:FluentWindow x:Class="Updater.App.RedownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="다시 받기" Width="440" Height="262" MinWidth="0" MinHeight="0" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel>
        <ui:TitleBar Title="다시 받기" ShowMinimize="False" ShowMaximize="False"/>
        <StackPanel Margin="20,8,20,16">
            <TextBlock x:Name="TxtTarget" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,10"
                       Text="아래 날짜 이후에 올라온 게시물을 받은 기록과 무관하게 다시 받습니다. 이미 폴더에 있는 파일은 건너뜁니다."/>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">이 날짜 이후</TextBlock>
                <DatePicker x:Name="Picker" Width="160"/>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
                <ui:Button Content="1개월" Click="Preset_Click" Tag="1" Padding="10,3" FontSize="12"/>
                <ui:Button Content="3개월" Click="Preset_Click" Tag="3" Padding="10,3" FontSize="12" Margin="6,0,0,0"/>
                <ui:Button Content="1년" Click="Preset_Click" Tag="12" Padding="10,3" FontSize="12" Margin="6,0,0,0"/>
                <ui:Button Content="전체" Click="Preset_Click" Tag="0" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                           ToolTip="받은 기록을 무시하고 이 작가의 모든 게시물을 다시 확인합니다"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="취소" IsCancel="True" Padding="18,6"/>
                <ui:Button Content="다시 받기" Appearance="Primary" IsDefault="True" Click="BtnOk_Click"
                           Margin="8,0,0,0" Padding="18,6"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
