<ui:FluentWindow x:Class="Updater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Updater.App"
        Title="Fanbox Updater" Height="700" Width="1060" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Fanbox Updater">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock x:Name="TxtVersion" VerticalAlignment="Center" Margin="8,0"
                           Foreground="#808080" FontSize="12"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 상단 커맨드 바 -->
        <Border Grid.Row="1" Padding="16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button x:Name="BtnSync" Click="BtnSync_Click" Appearance="Primary"
                               Content="▶  지금 최신화" FontWeight="SemiBold" Padding="18,8"
                               ToolTip="작가 탭에서 보고 있는 사이트의, 동기화가 켜진 작가의 새 게시물을 받습니다 (F5). 다른 사이트는 받지 않습니다"/>
                    <ui:Button x:Name="BtnStop" Click="BtnStop_Click" IsEnabled="False"
                               Content="■  중지" Margin="8,0,0,0" Padding="14,8" ToolTip="진행 중인 동기화를 멈춥니다 (Esc)"/>
                    <ui:Button x:Name="BtnRefresh" Click="BtnRefresh_Click"
                               Content="↻  작가 목록 새로고침" Margin="8,0,0,0" Padding="14,8"
                               ToolTip="FANBOX·Patreon에서 팔로우/후원 작가 목록을 가져와 폴더와 자동 매칭합니다 (Ctrl+R)"/>
                    <ui:Button x:Name="BtnRedownload" Click="BtnRedownload_Click"
                               Content="선택 작가 다시 받기" Margin="8,0,0,0" Padding="14,8"
                               ToolTip="작가 탭에서 작가를 선택한 뒤, 지정 날짜 이후 게시물을 받은 기록과 무관하게 다시 받습니다"/>
                    <ui:Button x:Name="BtnUpdate" Click="BtnUpdate_Click" Appearance="Caution"
                               Content="업데이트" Margin="8,0,0,0" Padding="14,8" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNextRun" Foreground="#808080" FontSize="12" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="TxtStatus" Text="대기 중" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="Progress" Height="6" Margin="0,5,0,0" Minimum="0" Maximum="100"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="12,8,12,4">
            <!-- 작가 탭 -->
            <TabItem Header="작가">
                <DockPanel Margin="4">
                    <!-- 처음 쓸 때 안내: 쿠키·저장 경로가 없으면 무엇을 해야 하는지 알려준다 -->
                    <Border x:Name="SetupBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="4,6,4,4"
                            Background="#2AFFB048" BorderBrush="#80FFB048" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="설정 탭 열기" Click="BtnGoSettings_Click"
                                       Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSetupTitle" FontWeight="SemiBold" Text="시작하기"/>
                                <TextBlock x:Name="TxtSetupMsg" TextWrapping="Wrap" FontSize="12" Foreground="#D0D0D0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 사이트 전환: 작가·폴더·분류는 사이트별로 완전히 분리 (버튼은 ProviderRegistry.SupportedProviders로 코드에서 생성) -->
                    <DockPanel DockPanel.Dock="Top" Margin="4,6,4,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ui:TextBox x:Name="TxtSearch" Width="230" Margin="0,0,12,0" FontSize="12"
                                        PlaceholderText="폴더명·작가명·ID 검색" ClearButtonEnabled="True"
                                        TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9A9A9A">분류</TextBlock>
                            <ComboBox x:Name="CmbFilter" Width="130" SelectionChanged="CmbFilter_SelectionChanged"/>
                        </StackPanel>
                        <Border x:Name="SiteSwitcher" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                                Background="#14FFFFFF" CornerRadius="8" Padding="3"
                                ToolTip="사이트별로 작가·폴더·분류가 따로 관리됩니다">
                            <StackPanel x:Name="SitePanel" Orientation="Horizontal"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSummary" FontSize="12.5" Foreground="#C8C8C8"/>
                            <TextBlock Foreground="#8A8A8A" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,16,0"
                                       Text="매칭 안 된 폴더(주황)는 [선택] 버튼으로 작가와 연결하세요. 더블클릭 → 폴더 열기, 우클릭 → 더 보기."/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="GridArtists" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              BorderThickness="0" RowHeight="34" SelectionMode="Single"
                              CellEditEnding="GridArtists_CellEditEnding"
                              MouseDoubleClick="GridArtists_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="폴더 열기" Click="MenuOpenFolder_Click"/>
                                <MenuItem Header="작가 페이지 열기 (FANBOX / Patreon)" Click="MenuOpenCreatorPage_Click"/>
                                <Separator/>
                                <MenuItem Header="작가 매핑 변경..." Click="MenuMapCreator_Click"/>
                                <MenuItem Header="이 작가 다시 받기..." Click="BtnRedownload_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                        <Setter Property="Background" Value="#26FF8C50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✔"/>
                                                    <Setter Property="Foreground" Value="#6CCB5F"/>
                                                    <Setter Property="ToolTip" Value="작가와 매핑됨"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                            <Setter Property="Text" Value="!"/>
                                                            <Setter Property="Foreground" Value="#FF9472"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="ToolTip" Value="매핑 안 됨 — [선택] 버튼이나 creatorId 입력으로 연결하세요"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="92">
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox x:Name="ChkAllSync" Content="동기화" Click="ChkAllSync_Click"
                                              ToolTip="전체 선택/해제 (필터가 걸려 있으면 보이는 작가만)"/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="폴더명" Binding="{Binding FolderName}" IsReadOnly="True" Width="175"/>
                            <DataGridTemplateColumn Header="분류" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding CategoryOptions}"
                                                  Padding="8,2" FontSize="12" ToolTip="분류를 바꾸면 그 분류의 저장 루트로 폴더 이동을 물어봅니다"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="작가명" Binding="{Binding CreatorName}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Binding="{Binding CreatorId}" Width="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="creatorId" ToolTip="FANBOX: 작가 주소 https://xxxx.fanbox.cc 의 xxxx&#10;Patreon: patreon:이름 (주소 https://www.patreon.com/이름 의 이름)&#10;칸을 더블클릭해 직접 입력할 수도 있습니다"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="매핑" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,1" FontSize="11" Click="BtnMapCreator_Click"
                                                ToolTip="팔로우/후원 중인 작가 목록에서 골라 이 폴더와 수동 매핑">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="변경"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                            <Setter Property="Content" Value="선택"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding IllustThreshold}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="일러 기준(장)" ToolTip="이 작가만의 일러스트 분리 기준 장수. 빈칸=설정 탭 기본값, 0=분리 안 함"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" IsReadOnly="True" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:MatchStatus.Unmatched}">
                                                <Setter Property="Foreground" Value="#FF9472"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:MatchStatus.Unknown}">
                                                <Setter Property="Foreground" Value="#9A9A9A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:MatchStatus.Auto}">
                                                <Setter Property="Foreground" Value="#6CCB5F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:MatchStatus.Manual}">
                                                <Setter Property="Foreground" Value="#60CDFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="받은 게시물" Binding="{Binding DownloadedCount}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="최근 결과" Binding="{Binding LastResult}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 설정 탭: 위 = 공통 설정 (하나만, 고정), 아래 = 사이트별 설정 (토글로 전환) -->
            <TabItem Header="설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,8" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                                   Text="모든 설정은 바꾸는 즉시 자동 저장·반영됩니다. 글자 입력칸은 다른 곳을 클릭하면 반영돼요."/>

                        <!-- ===== 공통 설정 (모든 사이트에 적용) ===== -->
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8" FontSize="16">공통 설정</TextBlock>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">저장 규칙</TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}">게시물 폴더 이름 규칙</TextBlock>
                                    <ui:TextBox x:Name="TxtTemplate" Grid.Column="1" Margin="0,3"
                                                ToolTip="{}{date}=날짜, {title}=제목, {id}=게시물번호, {creator}=작가ID"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}">날짜 형식</TextBlock>
                                    <ui:TextBox x:Name="TxtDateFormat" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="160" HorizontalAlignment="Left"
                                                ToolTip="예: yyyy-MM-dd, yyyyMMdd, yy.MM.dd"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}">동시 다운로드 수</TextBlock>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <ui:TextBox x:Name="TxtParallel" Margin="0,3" Width="70" TextAlignment="Center"/>
                                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0" Text="1~8. 한 게시물 안의 파일을 동시에 받는 수"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ChkFlatIllustOnly" Margin="0,8,0,0"
                                          ToolTip="사이트별 '게시물 폴더 없이 작가 폴더에 바로 저장'을 켠 사이트에서, 일러스트 저장 경로로 분리되는 낱장 일러 게시물에만 적용하고 그 밖의 게시물은 평소처럼 게시물 폴더로 저장">평평 저장은 일러스트(분리 저장) 게시물만 적용 — 나머지는 게시물 폴더로</CheckBox>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="모든 사이트에 한 번에 적용됩니다. 각 사이트의 '게시물 폴더 없이 작가 폴더에 바로 저장'이 켜져 있을 때만 의미가 있습니다."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">자동 실행 스케줄</TextBlock>
                                <CheckBox x:Name="ChkSchedule" Margin="0,0,0,6">자동 최신화 사용 (프로그램이 트레이에 있을 때 동작 — 로그인된 모든 사이트)</CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                            IsEnabled="{Binding IsChecked, ElementName=ChkSchedule}">
                                    <RadioButton x:Name="RadDaily" GroupName="sched" VerticalAlignment="Center">매일</RadioButton>
                                    <ui:TextBox x:Name="TxtDailyTime" Width="76" Margin="8,0" ToolTip="HH:mm (예: 03:00)" TextAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,28,0">에 실행</TextBlock>
                                    <RadioButton x:Name="RadInterval" GroupName="sched" VerticalAlignment="Center">매</RadioButton>
                                    <ui:TextBox x:Name="TxtIntervalHours" Width="56" Margin="8,0" TextAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center">시간마다 실행</TextBlock>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="창을 닫아도 트레이에서 계속 실행됩니다. 완전히 종료하려면 트레이 아이콘 우클릭 → 종료."/>
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,8,0,6">동작</TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkStartMin" Margin="0,2,18,2">시작 시 트레이로 최소화</CheckBox>
                                    <CheckBox x:Name="ChkCloseTray" Margin="0,2,18,2">닫기 버튼 → 트레이로 이동</CheckBox>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== 사이트별 설정 (토글로 전환 — 버튼은 코드에서 생성, 작가 탭과 같은 선택을 공유) ===== -->
                        <DockPanel Margin="0,10,0,10">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center">사이트별 설정</TextBlock>
                            <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Background="#14FFFFFF" CornerRadius="8" Padding="3">
                                <StackPanel x:Name="SettingsSitePanel" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="12" TextWrapping="Wrap"
                                       Text="아래 세 카드(계정 · 저장 분류 · 게시물/다운로드)는 선택한 사이트에만 적용됩니다."/>
                        </DockPanel>

                        <!-- 계정 (사이트별) -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock x:Name="TxtAccountTitle" Style="{StaticResource SectionTitle}">계정</TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblCookie" Style="{StaticResource FieldLabel}">쿠키</TextBlock>
                                    <ui:PasswordBox x:Name="PwdSession" Grid.Column="1" RevealButtonEnabled="True"
                                                    PlaceholderText="브라우저에서 복사한 쿠키 값 (비워 두면 이 사이트는 사용 안 함)"/>
                                    <ui:Button x:Name="BtnTestSession" Grid.Column="2" Content="연결 확인" Margin="8,0,0,0" Padding="12,5"
                                               Click="BtnTestSession_Click" ToolTip="쿠키로 로그인되는지 확인하고 팔로우/후원 작가 수를 보여줍니다"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0">
                                    <Run x:Name="RunCookieHint"/>
                                    <LineBreak/>
                                    <Hyperlink Click="LinkSite_Click" Foreground="#60CDFF"><Run x:Name="RunSiteLink">사이트 열기</Run></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 저장 분류 (사이트별) -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock x:Name="TxtCategoryTitle" Style="{StaticResource SectionTitle}">저장 분류</TextBlock>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="이 사이트 전용 분류입니다. 분류별 저장 루트 폴더를 자유롭게 추가/삭제하세요. 각 루트 바로 아래 하위 폴더가 이 사이트의 작가 폴더로 매칭되며, 첫 번째 분류가 기본값입니다."/>
                                <DataGrid x:Name="GridCategories" AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                          BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                          RowHeight="30" MaxHeight="220" Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="72">
                                            <DataGridCheckBoxColumn.Header>
                                                <CheckBox Content="선택" Click="ChkAllCategories_Click"
                                                          ToolTip="전체 선택/해제 — 체크한 분류를 '선택 삭제'로 지울 수 있습니다"/>
                                            </DataGridCheckBoxColumn.Header>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTextColumn Header="분류 이름" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                        <DataGridTextColumn Header="저장 루트 경로" Binding="{Binding Path}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="…" Padding="8,0" FontSize="12" Click="BtnBrowseCategory_Click"
                                                            ToolTip="저장 루트 폴더 선택"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="일러 분리" Binding="{Binding SplitIllust, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:Button x:Name="BtnAddCategory" Click="BtnAddCategory_Click" Content="＋ 분류 추가" Padding="12,4"/>
                                    <ui:Button x:Name="BtnRemoveCategory" Click="BtnRemoveCategory_Click" Content="선택 삭제" Margin="8,0,0,0" Padding="12,4"/>
                                </StackPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}">일러스트 저장 경로</TextBlock>
                                    <ui:TextBox x:Name="TxtIllustRoot" Grid.Column="1" Margin="0,3" PlaceholderText="비워 두면 분리하지 않음"
                                                ToolTip="'일러 분리' 체크된 분류 작가의 낱장 일러스트 게시물이 이 경로로 저장됩니다"/>
                                    <ui:Button Grid.Column="2" Content="…" Padding="10,4" Margin="6,3,0,3"
                                               Click="BtnBrowseIllust_Click" ToolTip="폴더 선택"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock VerticalAlignment="Center">일러 분리 기준 — 이미지</TextBlock>
                                    <ui:TextBox x:Name="TxtIllustMax" Width="56" Margin="6,0" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center">장 이하 + 영상·압축 없음이면 위 경로로 분리 저장</TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 게시물 · 다운로드 (사이트별) -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock x:Name="TxtDownloadTitle" Style="{StaticResource SectionTitle}">게시물 · 다운로드</TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkPaid" Margin="0,2,18,2" FontWeight="SemiBold">유료(후원·플랜 구독) 게시물 받기</CheckBox>
                                    <CheckBox x:Name="ChkFree" Margin="0,2,18,2" FontWeight="SemiBold">무료(공개) 게시물 받기</CheckBox>
                                </WrapPanel>
                                <TextBlock x:Name="TxtPostFilterHint" Style="{StaticResource HintText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="ChkFlat" VerticalAlignment="Center">게시물 폴더 없이 작가 폴더에 파일을 바로 저장 — 파일명</CheckBox>
                                    <ui:TextBox x:Name="TxtFlatTemplate" Width="170" Margin="8,0,0,0" FontSize="12"
                                                IsEnabled="{Binding IsChecked, ElementName=ChkFlat}"
                                                ToolTip="{}{title}=제목, {index}=파일 순번, {id}=게시물번호, {date}=날짜, {creator}=작가ID (확장자는 자동)"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="예: {title}_{index} → 제목_01.jpg, 제목_02.jpg … / {id}_{index} → 게시물번호_01.jpg. 글 내용은 '폴더 이름 규칙'으로 지은 .txt로 저장됩니다. 일러스트 게시물만 평평하게 받으려면 위 공통 설정의 '일러스트 게시물만 적용'을 켜세요."/>
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="ChkSaveText" Margin="0,2,18,2">글 내용 저장 (post.txt)</CheckBox>
                                    <CheckBox x:Name="ChkCover" Margin="0,2,18,2">표지 이미지 저장</CheckBox>
                                    <CheckBox x:Name="ChkAutoCreate" Margin="0,2,18,2">폴더 없는 팔로우 작가도 자동 생성</CheckBox>
                                </WrapPanel>
                                <CheckBox x:Name="ChkExternal" Margin="0,2">외부 링크 자동 다운로드 (Dropbox · Google Drive · 직접 링크)</CheckBox>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="본문에 걸린 외부 배포 링크를 자동으로 받습니다. 미지원 호스트(MEGA 등)는 post.txt에 링크로 저장됩니다."/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox x:Name="ChkAutoExtract">압축파일 자동 해제 (zip)</CheckBox>
                                    <CheckBox x:Name="ChkDeleteArchive" Margin="18,0,0,0"
                                              IsEnabled="{Binding IsChecked, ElementName=ChkAutoExtract}">해제 후 원본 zip 삭제</CheckBox>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                           Text="받은 zip을 게시물 폴더 안에 압축파일명과 같은 폴더로 풉니다. 일본어 파일명(Shift-JIS)도 지원, RAR·7z는 미지원."/>
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,8,0,6">받을 파일 종류</TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkImages" Margin="0,2,18,2">이미지</CheckBox>
                                    <CheckBox x:Name="ChkVideos" Margin="0,2,18,2">영상</CheckBox>
                                    <CheckBox x:Name="ChkArchives" Margin="0,2,18,2">압축파일</CheckBox>
                                    <CheckBox x:Name="ChkOthers" Margin="0,2,18,2">기타</CheckBox>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                            <ui:Button x:Name="BtnSaveSettings" Click="BtnSaveSettings_Click" Appearance="Primary"
                                       Content="지금 저장" FontWeight="SemiBold" Padding="24,8"
                                       ToolTip="자동 저장되지만, 입력 중인 칸까지 바로 반영하고 싶을 때 누르세요"/>
                            <ui:Button Content="데이터 폴더 열기" Click="BtnOpenDataDir_Click" Margin="10,0,0,0" Padding="14,8"
                                       ToolTip="settings.json · state.json · app.log가 있는 폴더"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">제거</TextBlock>
                                <WrapPanel>
                                    <ui:Button x:Name="BtnUninstall" Click="BtnUninstall_Click" Content="프로그램 제거" Padding="14,6"
                                               ToolTip="Fanbox Updater를 PC에서 제거합니다. 받아둔 파일은 지우지 않습니다."/>
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="받아둔 파일과 저장 폴더는 지우지 않습니다."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 로그 탭 -->
            <TabItem Header="로그">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <CheckBox x:Name="ChkAutoScroll" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center">자동 스크롤</CheckBox>
                            <ui:Button Content="지우기" Click="BtnClearLog_Click" Padding="12,4" ToolTip="화면의 로그만 지웁니다 (app.log는 유지)"/>
                            <ui:Button Content="로그 파일 열기" Click="BtnOpenLogFile_Click" Margin="8,0,0,0" Padding="12,4"/>
                        </StackPanel>
                        <TextBlock Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center"
                                   Text="동기화 진행 기록. 파일(app.log)에도 같은 내용이 저장됩니다."/>
                    </DockPanel>
                    <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" BorderThickness="0"
                             HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 하단 상태 바 -->
        <Border Grid.Row="3" Padding="16,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <TextBlock x:Name="TxtStatusBar" Foreground="#9A9A9A" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 업데이트 진행 오버레이 -->
        <Grid x:Name="UpdateOverlay" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#D00E0E12" Panel.ZIndex="99">
            <Border MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Background="#FF1C1B22" BorderBrush="#FF77A8" BorderThickness="1.5"
                    Padding="36,30">
                <StackPanel>
                    <TextBlock x:Name="TxtUpdateFace" Text="(´｡• ᵕ •｡`)" FontSize="38"
                               HorizontalAlignment="Center" Foreground="#FFB7D5"/>
                    <TextBlock x:Name="TxtUpdateMsg" Text="새 버전을 데려오는 중이에요..." FontSize="14"
                               HorizontalAlignment="Center" Margin="0,14,0,2" Foreground="#E6E6EB"/>
                    <TextBlock x:Name="TxtUpdatePct" Text="0%" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#FF9ECF"/>
                    <ProgressBar x:Name="UpdateProgress" Height="10" Margin="0,14,0,0"
                                 Minimum="0" Maximum="100" Foreground="#FF77A8"/>
                    <TextBlock Text="☆ 잠시만 기다려 주세요 ☆" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,12,0,0" Foreground="#8A8A95"/>
                    <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="8" Background="#22FF77A8">
                        <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C9C9D4"
                                   Text="백신(V3 등)이 새 파일을 검사하는 동안 재시작이 몇 분 늦어질 수 있어요. 앱이 바로 다시 뜨길 원하면 백신의 검사 예외에 이 폴더를 추가해 주세요:&#10;%LocalAppData%\FanboxUpdater"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
